class Solution {
    public String removeDigit(String number, char digit) {

        String maximum = "";

        for (int i = 0; i < number.length(); i++) {

            if (number.charAt(i) == digit) {

                String result = number.substring(0, i)
                             + number.substring(i + 1);

                if (result.compareTo(maximum) > 0) {
                    maximum = result;
                }
            }
        }

        return maximum;
    }
}
