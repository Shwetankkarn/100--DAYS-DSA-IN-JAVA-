// method-02

class Solution {
    public int[] countServers(int n, int[][] logs, int x, int[] queries) {

        int m = logs.length;
        int q = queries.length;

        int[] ans = new int[q];

        Arrays.sort(logs, (a, b) -> a[1] - b[1]);


        Integer[] indices = new Integer[q];

        for(int i = 0; i < q; i++){
            indices[i] = i;
        }
        Arrays.sort(indices, (a, b) -> queries[a] - queries[b]);

        int[] freq = new int[n + 1];

        int left = 0;
        int right = 0;

        int active = 0;

        for(int i = 0; i < q; i++){

            int idx = indices[i];

            int query = queries[idx];

            int start = query - x;

            while(right < m && logs[right][1] <= query){

                int server = logs[right][0];

                if(freq[server] == 0){
                    active++;
                }

                freq[server]++;

                right++;
            }

            while(left < right && logs[left][1] < start){

                int server = logs[left][0];

                freq[server]--;

                if(freq[server] == 0){
                    active--;
                }

                left++;
            }

            ans[idx] = n - active;
        }

        return ans;
    }
}
