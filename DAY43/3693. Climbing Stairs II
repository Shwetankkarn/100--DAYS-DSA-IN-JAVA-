
import java.util.Arrays;

class Solution {
    public int climbStairs(int n, int[] costs) {

        int[] dp = new int[n + 1];
        Arrays.fill(dp, -1);

        return stairs(0, n, costs, dp);
    }

    public static int stairs(int i, int n, int[] costs, int[] dp) {

        if (i == n) return 0;

        // Already calculated?
        if (dp[i] != -1) return dp[i];

        int one = Integer.MAX_VALUE;
        int two = Integer.MAX_VALUE;
        int three = Integer.MAX_VALUE;

        if (i + 1 <= n) {
            one = stairs(i + 1, n, costs, dp)
                    + costs[i] + 1;
        }

        if (i + 2 <= n) {
            two = stairs(i + 2, n, costs, dp)
                    + costs[i + 1] + 4;
        }

        if (i + 3 <= n) {
            three = stairs(i + 3, n, costs, dp)
                    + costs[i + 2] + 9;
        }

        return dp[i] = Math.min(one, Math.min(two, three));
    }
}
