// METHOD:01

class Solution {
    public int countPrimes(int n) {
        boolean[] isComposite = new boolean[n];

        for (int i = 2; i <= Math.sqrt(n); i++) {
            if (isComposite[i]) {
                continue;
            }

            for (int j = i * i; j < n; j = j + i) {
                isComposite[j] = true;
            }
        }

        int count = 0;

        for (int i = 2; i < n; i++) {
            if (!isComposite[i]) {
                count++;
            }
        }

        return count;
    }
}

