class Solution {
    public int pivotIndex(int[] arr) {

        int left = 0;
        int high = arr.length - 1;

        int prefix = 0;
        int suffix = 0;

        for (int i = 0; i < arr.length; i++) {
            suffix += arr[i];
        }

        while (left <= high) {

            suffix -= arr[left];

            if (prefix == suffix) {
                return left;
            }

            prefix += arr[left];
            left++;
        }

        return -1;
    }
}
