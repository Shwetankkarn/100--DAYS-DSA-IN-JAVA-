class Solution {

   public static boolean exists(char[][]board, char[]word, int i, int j, int index){

    if(j>=board[0].length || j<0 || i<0 || i>=board.length || board[i][j]!=word[index] || board[i][j]== '*') return false;

      if(index==word.length-1) return true;
    char ch= board[i][j];
    board[i][j]= '*';

  boolean res= exists(board,word,i+1,j,index+1)||
     exists(board,word,i,j+1,index+1)||
      exists(board,word,i-1,j,index+1)||
      exists(board,word,i,j-1,index+1);
     
     board[i][j]= ch;
     return res;


   }



    public boolean exist(char[][] board, String word) {

        char[] ch_arr= word.toCharArray();
        
        for(int i=0; i<board.length; i++){
            for(int j=0; j<board[0].length; j++){
                if((board[i][j]==ch_arr[0]) && exists(board,ch_arr,i,j,0))
                return true;
            }
        }
        return false;
    }
}
